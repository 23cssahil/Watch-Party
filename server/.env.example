# ---- Server ----
# Render sets PORT automatically; falls back to 4000 locally.
PORT=4000

# Comma-separated list of allowed frontend origins.
# Local dev default (CLIENT_ORIGIN unset) already allows localhost:5173.
# Production example:
# CLIENT_ORIGIN=https://watch-party-phi.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ---- Database (OPTIONAL, and off until you set it) ----
# Persistence is a bonus feature. If this is empty the server runs with a
# purely in-memory room store, which is fine for the MVP and for free-tier
# deploys. Set it to a MongoDB Atlas connection string to keep room metadata +
# last known playback state across server restarts: `watch_party.rooms`, one
# document per party (see server/src/models/Room.js for what is stored and,
# just as importantly, what is not).
#
# The database name is taken from the path segment of this URI, so point it at
# its own database rather than reusing another project's:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/watch_party?retryWrites=true&w=majority
#
# Some networks (including certain ISPs and mobile hotspots) refuse the DNS SRV
# lookup behind `mongodb+srv://` and the driver fails with `querySrv
# ECONNREFUSED`. Atlas offers a "seed list" variant for exactly that case — same
# cluster, hosts written out, and it works everywhere:
#   mongodb://<user>:<password>@ac-xxxx-shard-00-00.xxxx.mongodb.net:27017,ac-xxxx-shard-00-01.xxxx.mongodb.net:27017,ac-xxxx-shard-00-02.xxxx.mongodb.net:27017/watch_party?ssl=true&replicaSet=<name>&authSource=admin&retryWrites=true
#
# Atlas also needs your IP in its Network Access list. Render's egress IPs change
# on every deploy, so a deployed app needs 0.0.0.0/0 there.
MONGODB_URI=
